{"data":{"sql":"/* {\"app\": \"dbt\", \"connection_name\": \"\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"01a15b25-bdba-7ab2-ab1a-b5c05d181a34\", \"profile_name\": \"elementary\", \"target_name\": \"dev\"} */\n/* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"01a15b25-bdba-7ab2-ab1a-b5c05d181a34\"} --END-ELEMENTARY-METADATA-- */\n    \n    with ordered_run_results as (\n      select\n        run_results.unique_id,\n        run_results.invocation_id,\n        row_number() over (partition by run_results.unique_id order by run_results.generated_at desc) as row_number\n      from bronze_development.elementary.dbt_run_results run_results\n      join bronze_development.elementary.dbt_models models on run_results.unique_id = models.unique_id\n    ),\n\n    latest_run_results as (\n      select unique_id, invocation_id\n      from ordered_run_results\n      where row_number = 1\n    )\n\n    select unique_id, invocation_id from latest_run_results"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"01a15b25-bdba-7ab2-ab1a-b5c05d181a34","level":"debug","msg":"-- created_at: 2026-10-20T21:09:24.917582061+00:00\n-- finished_at: 2026-10-20T21:09:25.982467120+00:00\n-- elapsed: 1.1s\n-- outcome: success\n-- dialect: databricks\n-- node_id: not available\n-- query_id: 01f1ccca-879d-1469-ae7b-fc4804f37d46\n-- desc: execute adapter call\n/* {\"app\": \"dbt\", \"connection_name\": \"\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"01a15b25-bdba-7ab2-ab1a-b5c05d181a34\", \"profile_name\": \"elementary\", \"target_name\": \"dev\"} */\n/* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"01a15b25-bdba-7ab2-ab1a-b5c05d181a34\"} --END-ELEMENTARY-METADATA-- */\n    \n    with ordered_run_results as (\n      select\n        run_results.unique_id,\n        run_results.invocation_id,\n        row_number() over (partition by run_results.unique_id order by run_results.generated_at desc) as row_number\n      from bronze_development.elementary.dbt_run_results run_results\n      join bronze_development.elementary.dbt_models models on run_results.unique_id = models.unique_id\n    ),\n\n    latest_run_results as (\n      select unique_id, invocation_id\n      from ordered_run_results\n      where row_number = 1\n    )\n\n    select unique_id, invocation_id from latest_run_results;\n","name":"SQLQuery","pid":34985,"thread":"dbt-blocking-worker","ts":"2026-10-20T21:09:25.982501Z"}}
