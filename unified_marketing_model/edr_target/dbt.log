{"data":{"sql":"/* {\"app\": \"dbt\", \"connection_name\": \"\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"01a15b24-f494-7b01-b979-33c1974ffb15\", \"profile_name\": \"elementary\", \"target_name\": \"dev\"} */\n/* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"01a15b24-f494-7b01-b979-33c1974ffb15\"} --END-ELEMENTARY-METADATA-- */\n    \n        with dbt_source_freshness_results as (\n            select\n                *,\n                \n    case\n        when status = 'error' then 'fail'\n        when status = 'runtime error' then 'error'\n        else status\n    end as normalized_status\n,\n                rank() over (partition by unique_id order by generated_at desc) as invocations_rank_index\n            from bronze_development.elementary.dbt_source_freshness_results\n            \n                where \n        \n        datediff(\n\n    coalesce(date(\n    current_timestamp::timestamp\n), nvl2(date(\n    current_timestamp::timestamp\n), assert_true(date(\n    current_timestamp::timestamp\n) is not null), null))\n\n, \n\n    coalesce(date(cast(generated_at as timestamp)), nvl2(date(cast(generated_at as timestamp)), assert_true(date(cast(generated_at as timestamp)) is not null), null))\n\n) < 90\n            \n        ),\n\n        dbt_sources as (\n            select * from bronze_development.elementary.dbt_sources\n        )\n\n        select\n            freshness.source_freshness_execution_id,\n            freshness.unique_id,\n            freshness.max_loaded_at,\n            freshness.generated_at,\n            freshness.status as original_status,\n            freshness.normalized_status,\n            \n            \n                freshness.error_after,\n                freshness.warn_after,\n                freshness.filter,\n            \n            freshness.max_loaded_at_time_ago_in_s,\n            freshness.snapshotted_at,\n            freshness.invocation_id,\n            freshness.error,\n            freshness.invocations_rank_index,\n            sources.database_name,\n            sources.schema_name,\n            sources.source_name,\n            sources.name as table_name,\n            sources.loaded_at_field,\n            sources.meta,\n            sources.tags,\n            sources.owner as owners,\n            sources.freshness_error_after as source_freshness_error_after,\n            sources.freshness_warn_after as source_freshness_warn_after,\n            sources.freshness_filter as source_freshness_filter,\n            sources.relation_name,\n            \n            \n                sources.freshness_description\n            \n        from dbt_source_freshness_results freshness\n        join dbt_sources sources on freshness.unique_id = sources.unique_id\n        where invocations_rank_index <= 720\n        order by freshness.unique_id, invocations_rank_index desc"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"01a15b24-f494-7b01-b979-33c1974ffb15","level":"debug","msg":"-- created_at: 2026-10-20T21:08:34.948527298+00:00\n-- finished_at: 2026-10-20T21:08:35.981883426+00:00\n-- elapsed: 1.0s\n-- outcome: success\n-- dialect: databricks\n-- node_id: not available\n-- query_id: 01f1ccca-69d5-1f49-b0f8-1388dd4531b9\n-- desc: execute adapter call\n/* {\"app\": \"dbt\", \"connection_name\": \"\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"01a15b24-f494-7b01-b979-33c1974ffb15\", \"profile_name\": \"elementary\", \"target_name\": \"dev\"} */\n/* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"01a15b24-f494-7b01-b979-33c1974ffb15\"} --END-ELEMENTARY-METADATA-- */\n    \n        with dbt_source_freshness_results as (\n            select\n                *,\n                \n    case\n        when status = 'error' then 'fail'\n        when status = 'runtime error' then 'error'\n        else status\n    end as normalized_status\n,\n                rank() over (partition by unique_id order by generated_at desc) as invocations_rank_index\n            from bronze_development.elementary.dbt_source_freshness_results\n            \n                where \n        \n        datediff(\n\n    coalesce(date(\n    current_timestamp::timestamp\n), nvl2(date(\n    current_timestamp::timestamp\n), assert_true(date(\n    current_timestamp::timestamp\n) is not null), null))\n\n, \n\n    coalesce(date(cast(generated_at as timestamp)), nvl2(date(cast(generated_at as timestamp)), assert_true(date(cast(generated_at as timestamp)) is not null), null))\n\n) < 90\n            \n        ),\n\n        dbt_sources as (\n            select * from bronze_development.elementary.dbt_sources\n        )\n\n        select\n            freshness.source_freshness_execution_id,\n            freshness.unique_id,\n            freshness.max_loaded_at,\n            freshness.generated_at,\n            freshness.status as original_status,\n            freshness.normalized_status,\n            \n            \n                freshness.error_after,\n                freshness.warn_after,\n                freshness.filter,\n            \n            freshness.max_loaded_at_time_ago_in_s,\n            freshness.snapshotted_at,\n            freshness.invocation_id,\n            freshness.error,\n            freshness.invocations_rank_index,\n            sources.database_name,\n            sources.schema_name,\n            sources.source_name,\n            sources.name as table_name,\n            sources.loaded_at_field,\n            sources.meta,\n            sources.tags,\n            sources.owner as owners,\n            sources.freshness_error_after as source_freshness_error_after,\n            sources.freshness_warn_after as source_freshness_warn_after,\n            sources.freshness_filter as source_freshness_filter,\n            sources.relation_name,\n            \n            \n                sources.freshness_description\n            \n        from dbt_source_freshness_results freshness\n        join dbt_sources sources on freshness.unique_id = sources.unique_id\n        where invocations_rank_index <= 720\n        order by freshness.unique_id, invocations_rank_index desc;\n","name":"SQLQuery","pid":34384,"thread":"dbt-blocking-worker","ts":"2026-10-20T21:08:35.981914Z"}}
