{"data":{"sql":"\nSELECT\n    table_name,\n    if(table_type IN ('EXTERNAL', 'MANAGED', 'MANAGED_SHALLOW_CLONE', 'EXTERNAL_SHALLOW_CLONE'), 'table', lower(table_type)) AS table_type,\n    lower(data_source_format) AS file_format,\n    table_schema,\n    table_owner,\n    table_catalog,\n    if(\n    table_type IN (\n        'EXTERNAL',\n        'MANAGED',\n        'MANAGED_SHALLOW_CLONE',\n        'EXTERNAL_SHALLOW_CLONE'\n    ),\n    lower(table_type),\n    NULL\n    ) AS databricks_table_type\nFROM `system`.`information_schema`.`tables`\nWHERE table_catalog = 'bronze_development'\n    AND table_schema = 'elementary'"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"01a15ae9-b373-7102-8654-d085eeec0f9f","level":"debug","msg":"-- created_at: 2026-10-20T20:03:50.312435232+00:00\n-- finished_at: 2026-10-20T20:03:50.885275192+00:00\n-- elapsed: 572ms\n-- outcome: success\n-- dialect: databricks\n-- node_id: not available\n-- query_id: 01f1ccc1-5e64-10d5-a3d5-c57090f3d753\n-- desc: get_relation > list_relations call\n\nSELECT\n    table_name,\n    if(table_type IN ('EXTERNAL', 'MANAGED', 'MANAGED_SHALLOW_CLONE', 'EXTERNAL_SHALLOW_CLONE'), 'table', lower(table_type)) AS table_type,\n    lower(data_source_format) AS file_format,\n    table_schema,\n    table_owner,\n    table_catalog,\n    if(\n    table_type IN (\n        'EXTERNAL',\n        'MANAGED',\n        'MANAGED_SHALLOW_CLONE',\n        'EXTERNAL_SHALLOW_CLONE'\n    ),\n    lower(table_type),\n    NULL\n    ) AS databricks_table_type\nFROM `system`.`information_schema`.`tables`\nWHERE table_catalog = 'bronze_development'\n    AND table_schema = 'elementary';\n","name":"SQLQuery","pid":29929,"thread":"dbt-blocking-worker","ts":"2026-10-20T20:03:50.885330Z"}}
