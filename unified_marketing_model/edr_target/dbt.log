{"data":{"sql":"/* {\"app\": \"dbt\", \"connection_name\": \"\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"01a15b25-706c-7603-8a49-f4a30cffe7ad\", \"profile_name\": \"elementary\", \"target_name\": \"dev\"} */\n/* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"01a15b25-706c-7603-8a49-f4a30cffe7ad\"} --END-ELEMENTARY-METADATA-- */\n    \n        with model_runs as (\n            select\n                *,\n                row_number() over (partition by unique_id order by generated_at desc) as invocations_rank_index\n            from bronze_development.elementary.model_run_results\n        )\n\n        select\n            unique_id,\n            invocation_id,\n            name,\n            schema_name as schema,\n            status,\n            case\n                when status != 'success' then 0\n                else round(cast(execution_time as numeric(28,6)), 1)\n            end as execution_time,\n            full_refresh,\n            materialization,\n            case when invocations_rank_index = 1 then compiled_code else NULL end as compiled_code,\n            generated_at\n        from model_runs\n        where \n        \n        datediff(\n\n    coalesce(date(\n    current_timestamp::timestamp\n), nvl2(date(\n    current_timestamp::timestamp\n), assert_true(date(\n    current_timestamp::timestamp\n) is not null), null))\n\n, \n\n    coalesce(date(cast(generated_at as timestamp)), nvl2(date(cast(generated_at as timestamp)), assert_true(date(cast(generated_at as timestamp)) is not null), null))\n\n) < 90\n        \n          and unique_id not like 'model.elementary.%'\n        \n        order by generated_at"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"01a15b25-706c-7603-8a49-f4a30cffe7ad","level":"debug","msg":"-- created_at: 2026-10-20T21:09:05.128456065+00:00\n-- finished_at: 2026-10-20T21:09:06.634386475+00:00\n-- elapsed: 1.5s\n-- outcome: success\n-- dialect: databricks\n-- node_id: not available\n-- query_id: 01f1ccca-7bd2-153a-b236-1380f0dd2889\n-- desc: execute adapter call\n/* {\"app\": \"dbt\", \"connection_name\": \"\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"01a15b25-706c-7603-8a49-f4a30cffe7ad\", \"profile_name\": \"elementary\", \"target_name\": \"dev\"} */\n/* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"01a15b25-706c-7603-8a49-f4a30cffe7ad\"} --END-ELEMENTARY-METADATA-- */\n    \n        with model_runs as (\n            select\n                *,\n                row_number() over (partition by unique_id order by generated_at desc) as invocations_rank_index\n            from bronze_development.elementary.model_run_results\n        )\n\n        select\n            unique_id,\n            invocation_id,\n            name,\n            schema_name as schema,\n            status,\n            case\n                when status != 'success' then 0\n                else round(cast(execution_time as numeric(28,6)), 1)\n            end as execution_time,\n            full_refresh,\n            materialization,\n            case when invocations_rank_index = 1 then compiled_code else NULL end as compiled_code,\n            generated_at\n        from model_runs\n        where \n        \n        datediff(\n\n    coalesce(date(\n    current_timestamp::timestamp\n), nvl2(date(\n    current_timestamp::timestamp\n), assert_true(date(\n    current_timestamp::timestamp\n) is not null), null))\n\n, \n\n    coalesce(date(cast(generated_at as timestamp)), nvl2(date(cast(generated_at as timestamp)), assert_true(date(cast(generated_at as timestamp)) is not null), null))\n\n) < 90\n        \n          and unique_id not like 'model.elementary.%'\n        \n        order by generated_at;\n","name":"SQLQuery","pid":34770,"thread":"dbt-blocking-worker","ts":"2026-10-20T21:09:06.634429Z"}}
