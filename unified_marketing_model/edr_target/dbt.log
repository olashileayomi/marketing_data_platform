{"data":{"sql":"/* {\"app\": \"dbt\", \"connection_name\": \"\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"01a15b25-80c6-7eb3-bce2-094f3d3e101a\", \"profile_name\": \"elementary\", \"target_name\": \"dev\"} */\n/* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"01a15b25-80c6-7eb3-bce2-094f3d3e101a\"} --END-ELEMENTARY-METADATA-- */\n    \n            with dbt_tests as (\n                select\n                    parent_model_unique_id,\n                    test_column_name\n                from bronze_development.elementary.dbt_tests\n            )\n\n            select \n                parent_model_unique_id as model_unique_id,\n                SUM(\n                    case \n                        when test_column_name is not null then 1\n                        else 0\n                        end\n                ) as column_tests,\n                 SUM(\n                    case\n                        when test_column_name is null then 1\n                        else 0\n                        end \n                )as table_tests\n            from dbt_tests\n            group by parent_model_unique_id"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"01a15b25-80c6-7eb3-bce2-094f3d3e101a","level":"debug","msg":"-- created_at: 2026-10-20T21:09:10.115484906+00:00\n-- finished_at: 2026-10-20T21:09:10.780082233+00:00\n-- elapsed: 664ms\n-- outcome: success\n-- dialect: databricks\n-- node_id: not available\n-- query_id: 01f1ccca-7ecb-1235-9847-806d08d85093\n-- desc: execute adapter call\n/* {\"app\": \"dbt\", \"connection_name\": \"\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"01a15b25-80c6-7eb3-bce2-094f3d3e101a\", \"profile_name\": \"elementary\", \"target_name\": \"dev\"} */\n/* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"01a15b25-80c6-7eb3-bce2-094f3d3e101a\"} --END-ELEMENTARY-METADATA-- */\n    \n            with dbt_tests as (\n                select\n                    parent_model_unique_id,\n                    test_column_name\n                from bronze_development.elementary.dbt_tests\n            )\n\n            select \n                parent_model_unique_id as model_unique_id,\n                SUM(\n                    case \n                        when test_column_name is not null then 1\n                        else 0\n                        end\n                ) as column_tests,\n                 SUM(\n                    case\n                        when test_column_name is null then 1\n                        else 0\n                        end \n                )as table_tests\n            from dbt_tests\n            group by parent_model_unique_id;\n","name":"SQLQuery","pid":34813,"thread":"dbt-blocking-worker","ts":"2026-10-20T21:09:10.780101Z"}}
